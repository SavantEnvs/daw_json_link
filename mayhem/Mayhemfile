project: savantenvs/daw_json_link
target: serializer-fuzz

# The owner/project half of the accumulation URI is PINNED to the Mayhem project SLUG
# (savantenvs/daw-json-link). $MAYHEM_PROJECT interpolates the CI --project, which mcode-action
# derives from the GitHub repo name (daw_json_link, underscore); Mayhem slugifies '_' -> '-', so
# the run lands in project 'daw-json-link' while the interpolated URI names 'daw_json_link' and the
# run-creation testsuite ACL check aborts: "You do not have access to use a test suite from the
# project daw_json_link". $MAYHEM_TARGET stays literal so each target keys its own tar.
testsuite:
  - https://$MAYHEM_DOMAIN/savantenvs/daw-json-link/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/serializer-fuzz/testsuite

cmds:
  - cmd: /mayhem/fuzz_serializer
    libfuzzer: true
